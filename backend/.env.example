# Copy this file to .env and fill in the values.
#
#   cp backend/.env.example backend/.env
#
# .env is gitignored — never commit it, and never hardcode a token in
# src/main.js.

# Port the API server listens on. Optional; defaults to 8787.
PORT=8787

# --- Re:Earth CMS -----------------------------------------------------------
# Not used yet. The instance, project and token for the workshop are still to
# be decided (see the open questions in plan.md). Uncomment and fill in when
# the step that talks to the CMS lands.

# Base URL of the Re:Earth CMS Integration API.
# REEARTH_CMS_BASE_URL=https://api.cms.reearth.io

# Integration API token. Treat as a secret.
# REEARTH_CMS_TOKEN=

# Project and model to read items from.
# REEARTH_CMS_PROJECT_ID=
# REEARTH_CMS_MODEL_ID=
